# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- LLM (Mistral La Plateforme: https://console.mistral.ai) ---
LLM_KEY=your-mistral-api-key-here
LLM_MODEL=ministral-8b-2512

# --- CORS: the exact origin(s) of the deployed frontend, comma separated ---
FRONTEND_ORIGIN=https://your-app.vercel.app

# Server
PORT=8000
